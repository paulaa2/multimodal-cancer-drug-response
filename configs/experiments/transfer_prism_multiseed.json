        "splits": [
          "transfer_prism"
        ],
        "target": "auc",
        "random-state": 7,
        "device": "cuda",
        "no-b2-tuned": true,
        "ablations": [
          "targets_expression_pca",
          "morgan_expression_pca"
        ],
        "output": "results/transfer_strict/seed_7/b6_modalities_metrics.csv",
        "summary": "results/transfer_strict/seed_7/b6_modalities_summary.json",
        "predictions-output": "results/transfer_strict/seed_7/predictions/b6_modalities.csv",
        "split-dir": "data/processed/transfer_checked"
