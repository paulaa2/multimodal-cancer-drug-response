{
  "name": "cold_drug_checked",
  "description": "Refresh five existing cold-drug folds using default expression profiles and predeclared XGBoost settings; compare targets and Morgan to fold-fitted mean effects. No tuning artifacts from other partitions.",
  "steps": [
    {
      "name": "reference_0",
      "module": "mcdrp.models.baseline_b0",
      "args": {
        "split-dir": "data/processed/splits/cv/cold_drug/fold_0",
        "splits": [
          "cold_drug"
        ],
        "output": "results/cv_checked/cold_drug/fold_0/b0_metrics.csv",
        "summary": "results/cv_checked/cold_drug/fold_0/b0_summary.json",
        "predictions-output": "results/predictions/cv_checked/cold_drug/fold_0/b0.csv"
      }
    },
    {
      "name": "modalities_0",
      "module": "mcdrp.models.ablation_b6",
      "args": {
        "split-dir": "data/processed/splits/cv/cold_drug/fold_0",
        "splits": [
          "cold_drug"
        ],
        "random-state": 42,
        "device": "cuda",
        "no-b2-tuned": true,
        "ablations": [
          "targets_expression_pca",
          "morgan_expression_pca"
        ],
        "output": "results/cv_checked/cold_drug/fold_0/b6_metrics.csv",
        "summary": "results/cv_checked/cold_drug/fold_0/b6_summary.json",
        "predictions-output": "results/predictions/cv_checked/cold_drug/fold_0/b6_targets.csv"
      }
    },
    {
      "name": "score_0",
      "module": "mcdrp.results.metrics_report",
      "args": {
        "prediction-dir": "results/predictions/cv_checked/cold_drug/fold_0",
        "split-dir": "data/processed/splits/cv/cold_drug/fold_0",
        "output": "results/cv_checked/cold_drug/fold_0/model_metrics.csv",
        "best-output": "results/cv_checked/cold_drug/fold_0/best.csv",
