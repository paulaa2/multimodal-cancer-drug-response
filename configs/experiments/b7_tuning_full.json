{
  "name": "b7_tuning_full",
  "description": "Tune B7 pretrained drug embedding models across all evaluation splits.",
  "steps": [
    {
      "name": "tune_b7_all_splits",
      "module": "mcdrp.models.tune_b7",
      "args": [
        "--drug-embeddings", "data/external/drug_embeddings.csv",
        "--embedding-prefix", "emb_",
        "--device", "cuda"
      ]
    },
    {
      "name": "compare_models",
      "module": "mcdrp.results.compare_baselines"
    },
    {
      "name": "cold_start_report",
      "module": "mcdrp.results.cold_start_report"
    }
  ]
}
