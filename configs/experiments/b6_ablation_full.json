{
  "name": "b6_ablation_full",
  "description": "Full B6 modality ablation study across interpolation and cold-start splits.",
  "steps": [
    {
      "name": "build_splits_full",
      "module": "mcdrp.splits.make_splits",
      "args": {
        "splits": [
          "random_pair",
          "cold_cell",
          "cold_tissue",
          "cold_drug",
          "cold_scaffold",
          "cold_both"
        ]
      }
    },
    {
      "name": "run_b6_ablation_all_splits",
      "module": "mcdrp.models.ablation_b6",
      "args": {
        "splits": [
          "random_pair",
          "cold_cell",
          "cold_tissue",
          "cold_drug",
          "cold_scaffold",
          "cold_both"
        ],
        "device": "cuda",
        "gene-sets": "builtin_cancer_core",
        "learning-rate": 0.03,
        "max-depth": 5,
        "n-estimators": 600
      }
    },
    {
      "name": "compare_models",
      "module": "mcdrp.results.compare_baselines",
      "args": {}
    },
    {
      "name": "cold_start_report",
      "module": "mcdrp.results.cold_start_report",
      "args": {
        "subset": "test"
      }
    },
    {
      "name": "ablation_report",
      "module": "mcdrp.results.ablation_report",
      "args": {
        "subset": "test",
        "reference": "morgan_expression_pca"
      }
    }
  ]
}
