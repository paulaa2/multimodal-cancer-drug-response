{
  "name": "b3_tuning_full",
  "description": "Tune B3 MLP independently on every evaluation split, including cold_tissue.",
  "steps": [
    {
      "name": "tune_b3_all_splits",
      "module": "mcdrp.models.tune_b3",
      "args": {
        "splits": [
          "random_pair",
          "cold_cell",
          "cold_tissue",
          "cold_drug",
          "cold_scaffold",
          "cold_both"
        ],
        "device": "cuda"
      }
    },
    {
      "name": "compare_models",
      "module": "mcdrp.results.compare_baselines",
      "args": {}
    },
    {
      "name": "cold_start_report",
      "module": "mcdrp.results.cold_start_report",
      "args": {
        "subset": "test"
      }
    }
  ]
}
