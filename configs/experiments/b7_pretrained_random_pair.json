{
  "name": "b7_pretrained_random_pair",
  "description": "Quick B7 pretrained drug embedding experiment on the random-pair split.",
  "steps": [
    {
      "name": "run_b7_pretrained_random_pair",
      "module": "mcdrp.models.pretrained_b7",
      "args": [
        "--drug-embeddings", "data/external/drug_embeddings.csv",
        "--embedding-prefix", "emb_",
        "--splits", "random_pair",
        "--device", "cuda"
      ]
    },
    {
      "name": "compare_models",
      "module": "mcdrp.results.compare_baselines"
    }
  ]
}
