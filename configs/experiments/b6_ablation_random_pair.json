{
  "name": "b6_ablation_random_pair",
  "description": "Quick B6 modality ablation study on the random-pair split.",
  "steps": [
    {
      "name": "run_b6_ablation_random_pair",
      "module": "src.mcdrp.models.ablation_b6",
      "args": {
        "splits": ["random_pair"],
        "device": "cuda",
        "gene-sets": "builtin_cancer_core"
      }
    },
    {
      "name": "compare_models",
      "module": "src.mcdrp.results.compare_baselines",
      "args": {}
    },
    {
      "name": "ablation_report",
      "module": "src.mcdrp.results.ablation_report",
      "args": {
        "subset": "test",
        "reference": "morgan_expression_pca"
      }
    }
  ]
}
